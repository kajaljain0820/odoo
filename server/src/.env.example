# Server environment variables
# Copy this to .env and fill in real values. Never commit .env.

# Server
PORT=5000
NODE_ENV=development

# PostgreSQL connection string
# Format: postgresql://USER:PASSWORD@HOST:PORT/DBNAME
DATABASE_URL=postgresql://postgres:password@localhost:5432/globetrotter

# JWT secrets — generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_ACCESS_SECRET=change_me_access_secret_at_least_64_chars
JWT_REFRESH_SECRET=change_me_refresh_secret_at_least_64_chars

# CORS — comma-separated list of allowed origins
CORS_ORIGIN=http://localhost:5173

# Local upload directory (absolute or relative to project root)
UPLOAD_DIR=./uploads
